# MongoDB connection string (required for Category & Product APIs)
# Required for Category, Product, Inventory, and Purchase APIs.
# Stock-changing operations use MongoDB multi-document transactions and need
# a replica set (MongoDB Atlas, or local: mongod --replSet rs0).
MONGODB_URI=mongodb://127.0.0.1:27017/aapkabazartonk

# Cloudinary (required for product image uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Authentication (single store owner)
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Used only by CLI bootstrap / password reset — never sent to the browser
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password
# OWNER_NAME=Store Owner

